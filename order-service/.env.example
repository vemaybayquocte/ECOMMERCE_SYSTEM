NODE_ENV=development
PORT=3001

# OpenTelemetry
OTEL_SERVICE_NAME=order-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# RabbitMQ
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=ecommerce.events

# Kafka (outbox relay: consumes Debezium's outbox.event.Order topic)
KAFKA_BROKERS=localhost:9092

# Auth (demo API-key -> JWT exchange; replace with a real IdP for production)
JWT_SECRET=dev-secret-change-me-in-prod
DEMO_API_KEY=demo-secret-key

# Postgres
DB_HOST=localhost
DB_PORT=5435
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=order_db
