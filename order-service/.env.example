NODE_ENV=development
PORT=3001

# OpenTelemetry
OTEL_SERVICE_NAME=order-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# RabbitMQ
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=ecommerce.events
# Consumer concurrency bound (bulkhead) - caps in-flight saga/RPC messages
# per replica so one pod can't claim unbounded work off the queue and
# starve DB connections / other replicas.
RABBITMQ_PREFETCH_COUNT=15

# RPC timeouts (ms). Each also drives its opossum circuit breaker's own
# timeout (RPC timeout + 1s buffer) - see order.service.ts/saga-orchestrator.service.ts.
CATALOG_RPC_TIMEOUT_MS=10000
INVENTORY_RPC_TIMEOUT_MS=10000

# Kafka (outbox relay: consumes Debezium's outbox.event.Order topic)
KAFKA_BROKERS=localhost:9092

# Auth: must match the JWT_SECRET used by auth-service, which issues the
# tokens this service verifies (stateless, no RPC back to auth-service)
JWT_SECRET=dev-secret-change-me-in-prod

# Postgres
DB_HOST=localhost
DB_PORT=5435
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=order_db
