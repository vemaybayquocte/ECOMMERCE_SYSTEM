NODE_ENV=development
PORT=3000

# OpenTelemetry
OTEL_SERVICE_NAME=gateway-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Downstream services this gateway reverse-proxies to
AUTH_SERVICE_URL=http://localhost:3004
ORDER_SERVICE_URL=http://localhost:3001
PAYMENT_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
CATALOG_SERVICE_URL=http://localhost:3005

# Rate limiting (applied to all proxied + own routes). Counter store is
# Redis (shared across gateway replicas) - if REDIS_URL is unreachable,
# the limiter fails open (requests pass unlimited) rather than 500ing.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
REDIS_URL=redis://localhost:6379

# Upstream proxy timeout (ms) - bounds how long the gateway waits on a
# downstream service before giving up. Kept above the internal RPC
# timeouts (order-service's CATALOG_RPC_TIMEOUT_MS/INVENTORY_RPC_TIMEOUT_MS)
# so the gateway doesn't cut the connection before an internal circuit
# breaker/timeout has a chance to resolve first.
PROXY_TIMEOUT_MS=15000
