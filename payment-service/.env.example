NODE_ENV=development
PORT=3002

# OpenTelemetry
OTEL_SERVICE_NAME=payment-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# RabbitMQ
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=ecommerce.events
# Consumer concurrency bound (bulkhead) - see rabbitmq.module.ts comment.
RABBITMQ_PREFETCH_COUNT=10

# Ty le mo phong loi ky thuat tam thoi (network/timeout) de kich hoat retry, 0-1
PAYMENT_TRANSIENT_FAILURE_RATE=0.2

# Circuit breaker timeout (ms) around the simulated payment gateway call.
PAYMENT_GATEWAY_TIMEOUT_MS=2000

# Postgres
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=payment_db
