NODE_ENV=development
PORT=3004

# OpenTelemetry
OTEL_SERVICE_NAME=auth-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# JWT - must match the same value across all services that verify tokens
# (order-service, gateway-service, catalog-service, ...)
JWT_SECRET=dev-secret-change-me-in-prod

# Postgres
DB_HOST=localhost
DB_PORT=5437
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db
